generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  employee @map("employee")
  manager  @map("manager")
  admin    @map("admin")

  @@map("user_role")
}

enum GoalSheetStatus {
  draft     @map("draft")
  submitted @map("submitted")
  returned  @map("returned")
  approved  @map("approved")
  locked    @map("locked")

  @@map("goal_sheet_status")
}

enum UomType {
  min_numeric @map("min_numeric")
  min_percent @map("min_percent")
  max_numeric @map("max_numeric")
  max_percent @map("max_percent")
  timeline    @map("timeline")
  zero        @map("zero")

  @@map("uom_type")
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4

  @@map("quarter")
}

enum QuarterlyStatus {
  not_started @map("not_started")
  on_track    @map("on_track")
  completed   @map("completed")

  @@map("quarterly_status")
}

enum AuditActorRole {
  employee @map("employee")
  manager  @map("manager")
  admin    @map("admin")

  @@map("audit_actor_role")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  firebaseUid  String?  @unique @map("firebase_uid") @db.VarChar(128)
  role         UserRole @default(employee)
  department   String?  @db.VarChar(255)
  designation  String?  @db.VarChar(255)
  managerId    String?  @map("manager_id") @db.Uuid
  employeeCode String?  @unique @map("employee_code") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  avatarUrl    String?  @map("avatar_url") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  manager                 User?             @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports           User[]            @relation("UserManager")
  goalSheets              GoalSheet[]       @relation("EmployeeGoalSheets")
  approvedGoalSheets      GoalSheet[]       @relation("GoalSheetApprover")
  createdGoalCycles       GoalCycle[]       @relation("GoalCycleCreator")
  createdThrustAreas      ThrustArea[]      @relation("ThrustAreaCreator")
  primaryOwnedSharedGoals Goal[]            @relation("SharedGoalPrimaryOwner")
  checkinComments         CheckinComment[]  @relation("CheckinManager")
  auditLogs               AuditLog[]        @relation("AuditChangedBy")
  notifications           Notification[]    @relation("NotificationRecipient")

  @@index([managerId], map: "idx_users_manager_id")
  @@index([role], map: "idx_users_role")
  @@index([department], map: "idx_users_department")
  @@map("users")
}

model GoalCycle {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  goalSettingOpens DateTime @map("goal_setting_opens") @db.Date
  q1Opens          DateTime @map("q1_opens") @db.Date
  q2Opens          DateTime @map("q2_opens") @db.Date
  q3Opens          DateTime @map("q3_opens") @db.Date
  q4Opens          DateTime @map("q4_opens") @db.Date
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creator         User?            @relation("GoalCycleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  goalSheets      GoalSheet[]
  escalationRules EscalationRule[]

  @@map("goal_cycles")
}

model GoalSheet {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String          @map("employee_id") @db.Uuid
  cycleId        String          @map("cycle_id") @db.Uuid
  status         GoalSheetStatus @default(draft)
  submittedAt    DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approvedAt     DateTime?       @map("approved_at") @db.Timestamptz(6)
  approvedBy     String?         @map("approved_by") @db.Uuid
  lockedAt       DateTime?       @map("locked_at") @db.Timestamptz(6)
  managerRemarks String?         @map("manager_remarks") @db.Text
  totalWeightage Decimal         @default(0) @map("total_weightage") @db.Decimal(5, 2)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee        User              @relation("EmployeeGoalSheets", fields: [employeeId], references: [id], onDelete: Cascade)
  cycle           GoalCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  approver        User?             @relation("GoalSheetApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  goals           Goal[]
  checkinComments CheckinComment[]

  @@unique([employeeId, cycleId], map: "uq_goal_sheets_employee_cycle")
  @@index([employeeId], map: "idx_goal_sheets_employee")
  @@index([status], map: "idx_goal_sheets_status")
  @@index([cycleId], map: "idx_goal_sheets_cycle")
  @@map("goal_sheets")
}

model ThrustArea {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  colorHex    String   @default("#2563EB") @map("color_hex") @db.VarChar(7)
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creator User?  @relation("ThrustAreaCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  goals   Goal[]

  @@map("thrust_areas")
}

model Goal {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sheetId          String   @map("sheet_id") @db.Uuid
  thrustAreaId     String   @map("thrust_area_id") @db.Uuid
  title            String   @db.VarChar(500)
  description      String?  @db.Text
  uomType          UomType  @map("uom_type")
  targetValue      Decimal? @map("target_value") @db.Decimal(15, 4)
  targetDate       DateTime? @map("target_date") @db.Date
  weightage        Decimal  @db.Decimal(5, 2)
  isShared         Boolean  @default(false) @map("is_shared")
  sharedFromGoalId String?  @map("shared_from_goal_id") @db.Uuid
  primaryOwnerId   String?  @map("primary_owner_id") @db.Uuid
  isLocked         Boolean  @default(false) @map("is_locked")
  displayOrder     Int      @default(0) @map("display_order")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet             GoalSheet         @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  thrustArea        ThrustArea        @relation(fields: [thrustAreaId], references: [id])
  sharedFromGoal    Goal?             @relation("SharedGoalTree", fields: [sharedFromGoalId], references: [id], onDelete: SetNull)
  sharedGoalChildren Goal[]           @relation("SharedGoalTree")
  primaryOwner      User?             @relation("SharedGoalPrimaryOwner", fields: [primaryOwnerId], references: [id], onDelete: SetNull)
  quarterlyUpdates  QuarterlyUpdate[]

  @@index([sheetId], map: "idx_goals_sheet")
  @@index([sharedFromGoalId], map: "idx_goals_shared_from")
  @@index([primaryOwnerId], map: "idx_goals_primary_owner")
  @@index([deletedAt], map: "idx_goals_deleted_at")
  @@map("goals")
}

model QuarterlyUpdate {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId        String          @map("goal_id") @db.Uuid
  quarter       Quarter
  actualValue   Decimal?        @map("actual_value") @db.Decimal(15, 4)
  actualDate    DateTime?       @map("actual_date") @db.Date
  actualZero    Boolean?        @map("actual_zero")
  status        QuarterlyStatus @default(not_started)
  computedScore Decimal?        @map("computed_score") @db.Decimal(8, 4)
  employeeNotes String?         @map("employee_notes") @db.Text
  isWindowOpen  Boolean         @default(true) @map("is_window_open")
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, quarter], map: "uq_quarterly_updates_goal_quarter")
  @@map("quarterly_updates")
}

model CheckinComment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sheetId            String   @map("sheet_id") @db.Uuid
  managerId          String   @map("manager_id") @db.Uuid
  quarter            Quarter
  overallComment     String   @map("overall_comment") @db.Text
  keyObservations    String?  @map("key_observations") @db.Text
  areasOfImprovement String?  @map("areas_of_improvement") @db.Text
  supportRequired    String?  @map("support_required") @db.Text
  checkinDate        DateTime @default(now()) @map("checkin_date") @db.Timestamptz(6)

  sheet   GoalSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  manager User      @relation("CheckinManager", fields: [managerId], references: [id])

  @@unique([sheetId, quarter], map: "uq_checkin_comments_sheet_quarter")
  @@map("checkin_comments")
}

model AuditLog {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType    String         @map("entity_type") @db.VarChar(50)
  entityId      String         @map("entity_id") @db.Uuid
  action        String         @db.VarChar(100)
  changedBy     String         @map("changed_by") @db.Uuid
  changedByRole AuditActorRole @map("changed_by_role")
  previousValue Json?          @map("previous_value")
  newValue      Json?          @map("new_value")
  reason        String?        @db.Text
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  userAgent     String?        @map("user_agent") @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation("AuditChangedBy", fields: [changedBy], references: [id])

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([changedBy], map: "idx_audit_changed_by")
  @@index([createdAt(sort: Desc)], map: "idx_audit_created")
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  type        String   @db.VarChar(100)
  title       String   @db.VarChar(500)
  body        String?  @db.Text
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt(sort: Desc)], map: "idx_notif_recipient")
  @@map("notifications")
}

model EscalationRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId         String?  @map("cycle_id") @db.Uuid
  triggerEvent    String   @map("trigger_event") @db.VarChar(100)
  daysThreshold   Int      @map("days_threshold")
  notifyEmployee  Boolean  @default(true) @map("notify_employee")
  notifyManager   Boolean  @default(true) @map("notify_manager")
  notifyAdmin     Boolean  @default(false) @map("notify_admin")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cycle GoalCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("escalation_rules")
}
